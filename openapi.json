{"openapi":"3.1.0","info":{"title":"BuyWhere Singapore Value Intelligence API","description":"Semantic product search over Singapore e-commerce with auditable value-scores derived from Shannon entropy across vendor price distributions.","version":"1.0.0"},"paths":{"/search":{"get":{"tags":["core"],"summary":"Search Singapore Products By Value Score","description":"Semantic product search over BuyWhere Singapore catalog, ranked by composite value-score\n(Shannon entropy + causal reliability + price rank). Returns structured output ready for\ndirect LLM agent consumption without postprocessing.\n\nUse this when: an agent needs ranked product recommendations for a Singapore market query\nwith auditable justification per product.\n\nDo NOT use this for: real-time stock ticker data, non-SGD markets, or exact product ID lookup\n(use /product/{product_id}/value_breakdown for that).","operationId":"search_singapore_products_by_value_score_search_get","security":[{"APIKeyHeader":[]}],"parameters":[{"name":"query","in":"query","required":true,"schema":{"type":"string","title":"Query"}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","default":10,"title":"Limit"}},{"name":"min_value_score","in":"query","required":false,"schema":{"type":"number","default":0.0,"title":"Min Value Score"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProductSearchResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/product/{product_id}/value_breakdown":{"get":{"tags":["core"],"summary":"Get Product Value Score Breakdown","description":"Returns the full auditable decomposition of the value-score formula for a specific product:\nentropy component, reliability component, price rank component, and the recommended vendor.\n\nUse this when: an LLM agent needs to cite the mathematical justification for a product\nrecommendation (e.g., 'recommended because value_score=0.82 driven by high vendor diversity').\n\nDo NOT use this for: bulk catalog exploration (use /search for that).","operationId":"get_product_value_score_breakdown_product__product_id__value_breakdown_get","security":[{"APIKeyHeader":[]}],"parameters":[{"name":"product_id","in":"path","required":true,"schema":{"type":"string","title":"Product Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ValueScoreBreakdownResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/product/{product_id}/price_distribution":{"get":{"tags":["core"],"summary":"Get Product Vendor Price Distribution","description":"Returns the full price-entropy analysis for a product: spread, coefficient of variation,\nShannon entropy, and a human-readable interpretation for LLM reasoning chains.\n\nUse this when: an agent needs to determine whether a product's price is stable across\nvendors (low entropy) or volatile/competitive (high entropy) before making a recommendation.\n\nDo NOT use this for: value-score ranking across multiple products (use /search for that).","operationId":"get_product_vendor_price_distribution_product__product_id__price_distribution_get","security":[{"APIKeyHeader":[]}],"parameters":[{"name":"product_id","in":"path","required":true,"schema":{"type":"string","title":"Product Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PriceDistributionResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/health":{"get":{"tags":["ops"],"summary":"Check Api And Upstream Health","description":"Returns liveness status and whether BuyWhere upstream is reachable.\n\nUse this for: health checks, uptime monitors, deployment readiness probes.\n\nDo NOT use this for: product queries or value-score computations.","operationId":"check_api_and_upstream_health_health_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HealthResponse"}}}}},"security":[]}}},"components":{"schemas":{"HTTPValidationError":{"properties":{"detail":{"items":{"$ref":"#/components/schemas/ValidationError"},"type":"array","title":"Detail"}},"type":"object","title":"HTTPValidationError"},"HealthResponse":{"properties":{"status":{"type":"string","title":"Status"},"upstream_reachable":{"type":"boolean","title":"Upstream Reachable"},"api_version":{"type":"string","title":"Api Version"},"timestamp":{"type":"number","title":"Timestamp"}},"type":"object","required":["status","upstream_reachable","api_version","timestamp"],"title":"HealthResponse"},"PriceDistributionResponse":{"properties":{"product_id":{"type":"string","title":"Product Id"},"title":{"type":"string","title":"Title"},"vendor_count":{"type":"integer","title":"Vendor Count"},"entropy_bits":{"type":"number","title":"Entropy Bits"},"entropy_normalized":{"type":"number","title":"Entropy Normalized"},"price_spread_sgd":{"type":"number","title":"Price Spread Sgd"},"coefficient_of_variation":{"type":"number","title":"Coefficient Of Variation"},"interpretation":{"type":"string","title":"Interpretation"}},"type":"object","required":["product_id","title","vendor_count","entropy_bits","entropy_normalized","price_spread_sgd","coefficient_of_variation","interpretation"],"title":"PriceDistributionResponse"},"ProductSearchResponse":{"properties":{"query":{"type":"string","title":"Query"},"result_count":{"type":"integer","title":"Result Count"},"currency":{"type":"string","title":"Currency"},"products":{"items":{"$ref":"#/components/schemas/RankedProduct"},"type":"array","title":"Products"},"computation_ms":{"type":"number","title":"Computation Ms"}},"type":"object","required":["query","result_count","currency","products","computation_ms"],"title":"ProductSearchResponse"},"RankedProduct":{"properties":{"product_id":{"type":"string","title":"Product Id"},"title":{"type":"string","title":"Title"},"category":{"type":"string","title":"Category"},"image_url":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Image Url"},"vendor_offers":{"items":{"$ref":"#/components/schemas/VendorOffer"},"type":"array","title":"Vendor Offers"},"price_min_sgd":{"type":"number","title":"Price Min Sgd"},"price_max_sgd":{"type":"number","title":"Price Max Sgd"},"price_mean_sgd":{"type":"number","title":"Price Mean Sgd"},"shannon_entropy_bits":{"type":"number","title":"Shannon Entropy Bits"},"causal_reliability_score":{"type":"number","title":"Causal Reliability Score"},"value_score":{"type":"number","title":"Value Score"},"value_score_explanation":{"type":"string","title":"Value Score Explanation"}},"type":"object","required":["product_id","title","category","image_url","vendor_offers","price_min_sgd","price_max_sgd","price_mean_sgd","shannon_entropy_bits","causal_reliability_score","value_score","value_score_explanation"],"title":"RankedProduct"},"ValidationError":{"properties":{"loc":{"items":{"anyOf":[{"type":"string"},{"type":"integer"}]},"type":"array","title":"Location"},"msg":{"type":"string","title":"Message"},"type":{"type":"string","title":"Error Type"},"input":{"title":"Input"},"ctx":{"type":"object","title":"Context"}},"type":"object","required":["loc","msg","type"],"title":"ValidationError"},"ValueScoreBreakdownResponse":{"properties":{"product_id":{"type":"string","title":"Product Id"},"title":{"type":"string","title":"Title"},"shannon_entropy_bits":{"type":"number","title":"Shannon Entropy Bits"},"max_possible_entropy_bits":{"type":"number","title":"Max Possible Entropy Bits"},"entropy_component":{"type":"number","title":"Entropy Component"},"reliability_component":{"type":"number","title":"Reliability Component"},"price_rank_component":{"type":"number","title":"Price Rank Component"},"composite_value_score":{"type":"number","title":"Composite Value Score"},"formula":{"type":"string","title":"Formula"},"recommended_vendor":{"type":"string","title":"Recommended Vendor"},"recommended_price_sgd":{"type":"number","title":"Recommended Price Sgd"}},"type":"object","required":["product_id","title","shannon_entropy_bits","max_possible_entropy_bits","entropy_component","reliability_component","price_rank_component","composite_value_score","formula","recommended_vendor","recommended_price_sgd"],"title":"ValueScoreBreakdownResponse"},"VendorOffer":{"properties":{"vendor_name":{"type":"string","title":"Vendor Name"},"price_sgd":{"type":"number","title":"Price Sgd"},"listing_url":{"type":"string","title":"Listing Url"},"in_stock":{"type":"boolean","title":"In Stock"},"intra_session_variance_proxy":{"type":"number","title":"Intra Session Variance Proxy"},"reliability_penalty":{"type":"number","title":"Reliability Penalty"}},"type":"object","required":["vendor_name","price_sgd","listing_url","in_stock","intra_session_variance_proxy","reliability_penalty"],"title":"VendorOffer"}},"securitySchemes":{"APIKeyHeader":{"type":"apiKey","in":"header","name":"X-API-Key"}}}}